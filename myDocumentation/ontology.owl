    <!-- http://www.example.org/emdso#ActionStatus -->


    <owl:Class rdf:about="http://www.example.org/emdso#ActionStatus">
        <rdfs:comment xml:lang="en">Current status of a field safety corrective action.</rdfs:comment>
        <rdfs:label xml:lang="en">Action Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ActionType -->


    <owl:Class rdf:about="http://www.example.org/emdso#ActionType">
        <rdfs:comment xml:lang="en">Type of field safety corrective action.</rdfs:comment>
        <rdfs:label xml:lang="en">Action Type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ActiveDevice -->


    <owl:Class rdf:about="http://www.example.org/emdso#ActiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:comment xml:lang="en">A device relying on electrical energy or other power source.</rdfs:comment>
        <rdfs:label xml:lang="en">Active Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ActiveImplant -->


    <owl:Class rdf:about="http://www.example.org/emdso#ActiveImplant">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#ActiveDevice"/>
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#ImplantableDevice"/>
        <rdfs:comment xml:lang="en">An active device intended to be totally or partially introduced surgically into the human body.</rdfs:comment>
        <rdfs:label xml:lang="en">Active Implantable Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ClassA -->


    <owl:Class rdf:about="http://www.example.org/emdso#ClassA">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#RiskClass"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ClassB -->


    <owl:Class rdf:about="http://www.example.org/emdso#ClassB">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#RiskClass"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ClassC -->


    <owl:Class rdf:about="http://www.example.org/emdso#ClassC">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#RiskClass"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ClassD -->


    <owl:Class rdf:about="http://www.example.org/emdso#ClassD">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#RiskClass"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ClassI -->


    <owl:Class rdf:about="http://www.example.org/emdso#ClassI">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#RiskClass"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ClassIII -->


    <owl:Class rdf:about="http://www.example.org/emdso#ClassIII">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#RiskClass"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ClassIIa -->


    <owl:Class rdf:about="http://www.example.org/emdso#ClassIIa">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#RiskClass"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ClassIIb -->


    <owl:Class rdf:about="http://www.example.org/emdso#ClassIIb">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#RiskClass"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ClosedStatus -->


    <owl:Class rdf:about="http://www.example.org/emdso#ClosedStatus">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#ActionStatus"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ContaminationRisk -->


    <owl:Class rdf:about="http://www.example.org/emdso#ContaminationRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to reagent or product contamination.</rdfs:comment>
        <rdfs:label xml:lang="en">Contamination Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#CriticalClassIIIIncident -->


    <owl:Class rdf:about="http://www.example.org/emdso#CriticalClassIIIIncident">
        <rdfs:comment xml:lang="en">Incident involving a Class III device associated with a critical severity risk.</rdfs:comment>
        <rdfs:label xml:lang="en">Critical Class III Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#CriticalRiskActiveImplant -->


    <owl:Class rdf:about="http://www.example.org/emdso#CriticalRiskActiveImplant">
        <rdfs:comment xml:lang="en">An active implantable device classified as Class III, representing the highest risk category for active implants.</rdfs:comment>
        <rdfs:label xml:lang="en">Critical Risk Active Implant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#CybersecurityRisk -->


    <owl:Class rdf:about="http://www.example.org/emdso#CybersecurityRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to exploitable software vulnerabilities.</rdfs:comment>
        <rdfs:label xml:lang="en">Cybersecurity Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#Device -->


    <owl:Class rdf:about="http://www.example.org/emdso#Device">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#MedicalEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/emdso#hasManufacturer"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/emdso#hasRiskClass"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/emdso#hasManufacturer"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A medical device or in vitro diagnostic device regulated under MDR or IVDR.</rdfs:comment>
        <rdfs:label xml:lang="en">Device</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Medical_device"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#DiagnosticRisk -->


    <owl:Class rdf:about="http://www.example.org/emdso#DiagnosticRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to diagnostic error.</rdfs:comment>
        <rdfs:label xml:lang="en">Diagnostic Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#FieldSafetyCorrectiveAction -->


    <owl:Class rdf:about="http://www.example.org/emdso#FieldSafetyCorrectiveAction">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#MedicalEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/emdso#correctsIncident"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/emdso#hasActionType"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A corrective action taken by a manufacturer for safety reasons in relation to a device made available on the market.</rdfs:comment>
        <rdfs:label xml:lang="en">Field Safety Corrective Action</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#HighRiskIVD -->


    <owl:Class rdf:about="http://www.example.org/emdso#HighRiskIVD">
        <rdfs:comment xml:lang="en">IVD devices classified as Class D representing the highest risk level.</rdfs:comment>
        <rdfs:label xml:lang="en">High Risk IVD</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#IVDR -->


    <owl:Class rdf:about="http://www.example.org/emdso#IVDR">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#RegulatoryFramework"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ImplantableActiveDevice -->


    <owl:Class rdf:about="http://www.example.org/emdso#ImplantableActiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#ActiveDevice"/>
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#ImplantableDevice"/>
        <rdfs:comment xml:lang="en">An implantable device that is also active.</rdfs:comment>
        <rdfs:label xml:lang="en">Implantable Active Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#ImplantableDevice -->


    <owl:Class rdf:about="http://www.example.org/emdso#ImplantableDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:comment xml:lang="en">A device designed to be totally or partially introduced into the human body.</rdfs:comment>
        <rdfs:label xml:lang="en">Implantable Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#InSituCorrection -->


    <owl:Class rdf:about="http://www.example.org/emdso#InSituCorrection">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#ActionType"/>
        <rdfs:label xml:lang="en">In-Situ Correction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#InVitroDiagnosticDevice -->


    <owl:Class rdf:about="http://www.example.org/emdso#InVitroDiagnosticDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:comment xml:lang="en">A device intended for the examination of specimens derived from the human body.</rdfs:comment>
        <rdfs:label xml:lang="en">In Vitro Diagnostic Device</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/In_vitro_diagnostics"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#Incident -->


    <owl:Class rdf:about="http://www.example.org/emdso#Incident">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#MedicalEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/emdso#hasAssociatedRisk"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/emdso#involvesDevice"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Any malfunction, deterioration or inadequacy of a device that might lead to death or serious deterioration of health.</rdfs:comment>
        <rdfs:label xml:lang="en">Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#InfectionRisk -->


    <owl:Class rdf:about="http://www.example.org/emdso#InfectionRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to device-related infection.</rdfs:comment>
        <rdfs:label xml:lang="en">Infection Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#InjuryRisk -->


    <owl:Class rdf:about="http://www.example.org/emdso#InjuryRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to patient injury.</rdfs:comment>
        <rdfs:label xml:lang="en">Injury Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#InterferenceRisk -->


    <owl:Class rdf:about="http://www.example.org/emdso#InterferenceRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to electromagnetic or other interference.</rdfs:comment>
        <rdfs:label xml:lang="en">Interference Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#MDR -->


    <owl:Class rdf:about="http://www.example.org/emdso#MDR">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#RegulatoryFramework"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#MalfunctionRisk -->


    <owl:Class rdf:about="http://www.example.org/emdso#MalfunctionRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to device malfunction.</rdfs:comment>
        <rdfs:label xml:lang="en">Malfunction Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#Manufacturer -->


    <owl:Class rdf:about="http://www.example.org/emdso#Manufacturer">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#MedicalEntity"/>
        <rdfs:comment xml:lang="en">A natural or legal person who designs, manufactures, packages and labels a device.</rdfs:comment>
        <rdfs:label xml:lang="en">Manufacturer</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Medical_device_manufacturer"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#MaterialRisk -->


    <owl:Class rdf:about="http://www.example.org/emdso#MaterialRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to material degradation or wear debris.</rdfs:comment>
        <rdfs:label xml:lang="en">Material Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#MedicalEntity -->


    <owl:Class rdf:about="http://www.example.org/emdso#MedicalEntity">
        <rdfs:comment xml:lang="en">Root class for all entities in the medical device safety domain.</rdfs:comment>
        <rdfs:label xml:lang="en">Medical Entity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#NearMissIncident -->


    <owl:Class rdf:about="http://www.example.org/emdso#NearMissIncident">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:comment xml:lang="en">An incident that did not lead to harm but had the potential to do so.</rdfs:comment>
        <rdfs:label xml:lang="en">Near-Miss Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#OpenStatus -->


    <owl:Class rdf:about="http://www.example.org/emdso#OpenStatus">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#ActionStatus"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#RadiationRisk -->


    <owl:Class rdf:about="http://www.example.org/emdso#RadiationRisk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:comment xml:lang="en">Risk related to unintended radiation exposure.</rdfs:comment>
        <rdfs:label xml:lang="en">Radiation Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#Recall -->


    <owl:Class rdf:about="http://www.example.org/emdso#Recall">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#ActionType"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#RegulatoryFramework -->


    <owl:Class rdf:about="http://www.example.org/emdso#RegulatoryFramework">
        <rdfs:comment xml:lang="en">European regulatory framework applicable to the device.</rdfs:comment>
        <rdfs:label xml:lang="en">Regulatory Framework</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#Risk -->


    <owl:Class rdf:about="http://www.example.org/emdso#Risk">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#MedicalEntity"/>
        <rdfs:comment xml:lang="en">A potential source of harm associated with a medical device.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#RiskClass -->


    <owl:Class rdf:about="http://www.example.org/emdso#RiskClass">
        <rdfs:comment xml:lang="en">Regulatory risk classification under MDR or IVDR.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk Class</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#SafetyAlert -->


    <owl:Class rdf:about="http://www.example.org/emdso#SafetyAlert">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#ActionType"/>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#SelfTestDevice -->


    <owl:Class rdf:about="http://www.example.org/emdso#SelfTestDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:comment xml:lang="en">A device intended by the manufacturer to be usable by lay persons.</rdfs:comment>
        <rdfs:label xml:lang="en">Self-Test Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#SeriousIncident -->


    <owl:Class rdf:about="http://www.example.org/emdso#SeriousIncident">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:comment xml:lang="en">An incident that directly or indirectly led to the death or serious deterioration of health of a patient.</rdfs:comment>
        <rdfs:label xml:lang="en">Serious Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/emdso#SingleUseDevice -->


    <owl:Class rdf:about="http://www.example.org/emdso#SingleUseDevice">
        <rdfs:subClassOf rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:comment xml:lang="en">A device intended for single use only.</rdfs:comment>
        <rdfs:label xml:lang="en">Single-Use Device</rdfs:label>
    </owl:Class>
    


