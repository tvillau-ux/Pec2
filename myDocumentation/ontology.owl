<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/emdso#"
     xml:base="http://www.example.org/emdso"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:emdso="http://www.example.org/emdso#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.example.org/emdso">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-23</terms:created>
        <terms:creator>Student PEC2</terms:creator>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <rdfs:comment xml:lang="en">Ontology modeling the European catalogue of high-risk medical devices and in vitro diagnostics under MDR (EU 2017/745) and IVDR (EU 2017/746), including devices, manufacturers, risks, incidents and field safety corrective actions (FSCA).</rdfs:comment>
        <rdfs:label xml:lang="en">EUDAMED Medical Device and IVD Safety Ontology</rdfs:label>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.example.org/emdso#affectsDeviceType -->


    <owl:ObjectProperty rdf:about="http://www.example.org/emdso#affectsDeviceType">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:range rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:comment xml:lang="en">Relates a risk to the type of device it may affect.</rdfs:comment>
        <rdfs:label xml:lang="en">affects device type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/emdso#correctsIncident -->


    <owl:ObjectProperty rdf:about="http://www.example.org/emdso#correctsIncident">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:comment xml:lang="en">Relates a field safety corrective action to the incident it corrects.</rdfs:comment>
        <rdfs:label xml:lang="en">corrects incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/emdso#hasActionStatus -->


    <owl:ObjectProperty rdf:about="http://www.example.org/emdso#hasActionStatus">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.example.org/emdso#ActionStatus"/>
        <rdfs:comment xml:lang="en">Specifies the current status of the corrective action.</rdfs:comment>
        <rdfs:label xml:lang="en">has action status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/emdso#hasActionType -->


    <owl:ObjectProperty rdf:about="http://www.example.org/emdso#hasActionType">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.example.org/emdso#ActionType"/>
        <rdfs:comment xml:lang="en">Specifies the type of corrective action taken.</rdfs:comment>
        <rdfs:label xml:lang="en">has action type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/emdso#hasAssociatedRisk -->


    <owl:ObjectProperty rdf:about="http://www.example.org/emdso#hasAssociatedRisk">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:comment xml:lang="en">Relates an incident to the identified risk.</rdfs:comment>
        <rdfs:label xml:lang="en">has associated risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/emdso#hasDeviceType -->


    <owl:ObjectProperty rdf:about="http://www.example.org/emdso#hasDeviceType">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:comment xml:lang="en">Relates a device to its device type category.</rdfs:comment>
        <rdfs:label xml:lang="en">has device type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/emdso#hasManufacturer -->


    <owl:ObjectProperty rdf:about="http://www.example.org/emdso#hasManufacturer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/emdso#Manufacturer"/>
        <rdfs:comment xml:lang="en">Relates a device to its manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">has manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/emdso#hasRegulatoryFramework -->


    <owl:ObjectProperty rdf:about="http://www.example.org/emdso#hasRegulatoryFramework">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/emdso#RegulatoryFramework"/>
        <rdfs:comment xml:lang="en">Relates a device to the applicable EU regulation.</rdfs:comment>
        <rdfs:label xml:lang="en">has regulatory framework</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/emdso#hasRiskClass -->


    <owl:ObjectProperty rdf:about="http://www.example.org/emdso#hasRiskClass">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:range rdf:resource="http://www.example.org/emdso#RiskClass"/>
        <rdfs:comment xml:lang="en">Relates a device to its regulatory risk classification.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk class</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/emdso#involvesDevice -->


    <owl:ObjectProperty rdf:about="http://www.example.org/emdso#involvesDevice">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:comment xml:lang="en">Relates an incident to the device involved.</rdfs:comment>
        <rdfs:label xml:lang="en">involves device</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/emdso#reportedBy -->


    <owl:ObjectProperty rdf:about="http://www.example.org/emdso#reportedBy">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:range rdf:resource="http://www.example.org/emdso#Manufacturer"/>
        <rdfs:comment xml:lang="en">Relates an incident to the reporting manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">reported by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.example.org/emdso#actionDate -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#actionDate">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date when the corrective action was initiated.</rdfs:comment>
        <rdfs:label xml:lang="en">action date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#authorizationNumber -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#authorizationNumber">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Authorization number issued by the competent authority.</rdfs:comment>
        <rdfs:label xml:lang="en">authorization number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#closureDate -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#closureDate">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date when the corrective action was closed.</rdfs:comment>
        <rdfs:label xml:lang="en">closure date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#competentAuthority -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#competentAuthority">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the national competent authority.</rdfs:comment>
        <rdfs:label xml:lang="en">competent authority</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#contactEmail -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#contactEmail">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Regulatory contact email of the manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">contact email</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#correctiveActionTaken -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#correctiveActionTaken">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether a corrective action was taken for the incident.</rdfs:comment>
        <rdfs:label xml:lang="en">corrective action taken</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#countriesAffected -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#countriesAffected">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Countries where the corrective action applies.</rdfs:comment>
        <rdfs:label xml:lang="en">countries affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#country -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#country">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Country where the manufacturer is established.</rdfs:comment>
        <rdfs:label xml:lang="en">country</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#countryReported -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#countryReported">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Country where the incident was reported.</rdfs:comment>
        <rdfs:label xml:lang="en">country reported</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#detectionDate -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#detectionDate">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date when the incident was detected.</rdfs:comment>
        <rdfs:label xml:lang="en">detection date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#deviceId -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#deviceId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Unique identifier of the device (e.g., DEV-001).</rdfs:comment>
        <rdfs:label xml:lang="en">device ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#deviceName -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#deviceName">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Commercial or technical name of the device.</rdfs:comment>
        <rdfs:label xml:lang="en">device name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#devicesAffected -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#devicesAffected">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of devices affected by the corrective action.</rdfs:comment>
        <rdfs:label xml:lang="en">devices affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#eudamedFscaRef -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#eudamedFscaRef">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Reference number of the FSCA in EUDAMED.</rdfs:comment>
        <rdfs:label xml:lang="en">EUDAMED FSCA reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#eudamedIncidentRef -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#eudamedIncidentRef">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Reference number of the incident in EUDAMED.</rdfs:comment>
        <rdfs:label xml:lang="en">EUDAMED incident reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#eudamedSRN -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#eudamedSRN">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Single Registration Number in EUDAMED.</rdfs:comment>
        <rdfs:label xml:lang="en">EUDAMED SRN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#eventDate -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#eventDate">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date when the adverse event occurred.</rdfs:comment>
        <rdfs:label xml:lang="en">event date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#fscaDescription -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#fscaDescription">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Detailed description of the field safety corrective action.</rdfs:comment>
        <rdfs:label xml:lang="en">FSCA description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#fscaId -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#fscaId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/emdso#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Unique identifier of the field safety corrective action.</rdfs:comment>
        <rdfs:label xml:lang="en">FSCA ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#imdrfCode -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#imdrfCode">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Code according to the IMDRF nomenclature.</rdfs:comment>
        <rdfs:label xml:lang="en">IMDRF code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#incidentDescription -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#incidentDescription">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Narrative description of the incident.</rdfs:comment>
        <rdfs:label xml:lang="en">incident description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#incidentId -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#incidentId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Unique identifier of the incident.</rdfs:comment>
        <rdfs:label xml:lang="en">incident ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#intendedPurpose -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#intendedPurpose">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Clinical purpose for which the device is intended.</rdfs:comment>
        <rdfs:label xml:lang="en">intended purpose</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#isActive -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#isActive">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates if the device relies on an energy source.</rdfs:comment>
        <rdfs:label xml:lang="en">is active</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#isIVD -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#isIVD">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates if the device is an in vitro diagnostic.</rdfs:comment>
        <rdfs:label xml:lang="en">is IVD</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#isImplantable -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#isImplantable">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates if the device is designed to be implanted.</rdfs:comment>
        <rdfs:label xml:lang="en">is implantable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#isReusable -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#isReusable">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates if the device is intended for reuse.</rdfs:comment>
        <rdfs:label xml:lang="en">is reusable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#manufacturerId -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#manufacturerId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Unique identifier of the manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">manufacturer ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#manufacturerName -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#manufacturerName">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Legal name of the manufacturer.</rdfs:comment>
        <rdfs:label xml:lang="en">manufacturer name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#outcome -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#outcome">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Clinical or device-related outcome of the incident.</rdfs:comment>
        <rdfs:label xml:lang="en">outcome</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#patientAge -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#patientAge">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Age of the patient at the time of the incident.</rdfs:comment>
        <rdfs:label xml:lang="en">patient age</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#patientSex -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#patientSex">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Sex of the patient.</rdfs:comment>
        <rdfs:label xml:lang="en">patient sex</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#reportDate -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#reportDate">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date when the incident was reported to the authorities.</rdfs:comment>
        <rdfs:label xml:lang="en">report date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#riskDescription -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#riskDescription">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Detailed description of the risk.</rdfs:comment>
        <rdfs:label xml:lang="en">risk description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#riskId -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#riskId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Unique identifier of the risk.</rdfs:comment>
        <rdfs:label xml:lang="en">risk ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#riskName -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#riskName">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the risk.</rdfs:comment>
        <rdfs:label xml:lang="en">risk name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#riskProbability -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#riskProbability">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Probability level of the risk occurrence.</rdfs:comment>
        <rdfs:label xml:lang="en">risk probability</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#riskSeverity -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#riskSeverity">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Severity level of the risk.</rdfs:comment>
        <rdfs:label xml:lang="en">risk severity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#scopeDescription -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#scopeDescription">
        <rdfs:domain rdf:resource="http://www.example.org/emdso#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Description of the scope of the corrective action.</rdfs:comment>
        <rdfs:label xml:lang="en">scope description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/emdso#udiDI -->


    <owl:DatatypeProperty rdf:about="http://www.example.org/emdso#udiDI">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/emdso#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Unique Device Identifier - Device Identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">UDI-DI</rdfs:label>
    </owl:DatatypeProperty>
    


