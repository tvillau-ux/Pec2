#################################################################
#    Annotations
#################################################################

:ClassA rdfs:comment "Low risk IVDs under IVDR."@en ;
        rdfs:label "Class A"@en .


:ClassB rdfs:comment "Moderate risk IVDs under IVDR."@en ;
        rdfs:label "Class B"@en .


:ClassC rdfs:comment "High risk IVDs under IVDR."@en ;
        rdfs:label "Class C"@en .


:ClassD rdfs:comment "Very high risk IVDs under IVDR."@en ;
        rdfs:label "Class D"@en .


:ClassI rdfs:comment "Low risk medical devices under MDR."@en ;
        rdfs:label "Class I"@en .


:ClassIII rdfs:comment "High risk medical devices under MDR."@en ;
          rdfs:label "Class III"@en .


:ClassIIa rdfs:comment "Medium risk medical devices under MDR."@en ;
          rdfs:label "Class IIa"@en .


:ClassIIb rdfs:comment "Medium-high risk medical devices under MDR."@en ;
          rdfs:label "Class IIb"@en .


:ClosedStatus rdfs:label "Closed"@en .


:HeartMate_3_LVAD rdfs:seeAlso <https://dbpedia.org/resource/HeartMate> .


:IVDR rdfs:comment "In Vitro Diagnostics Regulation (EU) 2017/746."@en ;
      rdfs:label "IVDR"@en .


:MDR rdfs:comment "Medical Devices Regulation (EU) 2017/745."@en ;
     rdfs:label "MDR"@en .


:Medical_device rdfs:seeAlso <http://dbpedia.org/resource/Medical_device> .


:OpenStatus rdfs:label "Open"@en .


:Recall rdfs:label "Recall"@en .


:SafetyAlert rdfs:label "Safety Alert"@en .


#################################################################
#    Rules
#################################################################

[ rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
  <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                          rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                      <http://www.w3.org/2003/11/swrl#classPredicate> :InVitroDiagnosticDevice ;
                                                      <http://www.w3.org/2003/11/swrl#argument1> :d
                                                    ] ;
                                          rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                     rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                 <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasRiskClass ;
                                                                 <http://www.w3.org/2003/11/swrl#argument1> :d ;
                                                                 <http://www.w3.org/2003/11/swrl#argument2> :ClassD
                                                               ] ;
                                                     rdf:rest rdf:nil
                                                   ]
                                        ] ;
  <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                          rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                      <http://www.w3.org/2003/11/swrl#classPredicate> :HighRiskIVD ;
                                                      <http://www.w3.org/2003/11/swrl#argument1> :d
                                                    ] ;
                                          rdf:rest rdf:nil
                                        ]
] .

[ rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Incident ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :i
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :involvesDevice ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :i ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :d
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasRiskClass ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :d ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> :ClassIII
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasAssociatedRisk ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> :i ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> :r
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#propertyPredicate> :riskSeverity ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument1> :r ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument2> "Critical"
                                                                                                 ] ;
                                                                                       rdf:rest rdf:nil
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :CriticalClassIIIIncident ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :i
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
