###  http://www.example.org/emdso#FSCA-001
:FSCA-001 rdf:type owl:NamedIndividual ,
                   :FieldSafetyCorrectiveAction ;
          :correctsIncident :INC-001 ;
          :hasActionStatus :OpenStatus ;
          :hasActionType :SafetyAlert ;
          :actionDate "2024-02-01"^^xsd:date ;
          :countriesAffected "EU-wide" ;
          :devicesAffected 850 ;
          :eudamedFscaRef "EU-FSCA-2024-000001" ;
          :fscaDescription "Safety alert issued to all implanting centres regarding anticoagulation protocol update for HeartMate 3 to reduce device thrombosis risk. INR target range revised to 2.0-3.0." ;
          :fscaId "FSCA-001" ;
          :scopeDescription "All HeartMate 3 LVAD units implanted since 2020" ;
          rdfs:label "FSCA-001"@en .


###  http://www.example.org/emdso#FSCA-002
:FSCA-002 rdf:type owl:NamedIndividual ,
                   :FieldSafetyCorrectiveAction ;
          :correctsIncident :INC-002 ;
          :hasActionStatus :ClosedStatus ;
          :hasActionType :Recall ;
          :actionDate "2024-02-28"^^xsd:date ;
          :closureDate "2024-05-31"^^xsd:date ;
          :countriesAffected "EU-wide + UK" ;
          :devicesAffected 1240 ;
          :eudamedFscaRef "EU-FSCA-2024-000002" ;
          :fscaDescription "Voluntary recall of affected Micra AV lots due to premature battery depletion. Replacement units provided. 97% of affected devices successfully replaced." ;
          :fscaId "FSCA-002" ;
          :scopeDescription "Micra AV lots manufactured between 2022-09 and 2023-03" ;
          rdfs:label "FSCA-002"@en .


###  http://www.example.org/emdso#INC-001
:INC-001 rdf:type owl:NamedIndividual ,
                  :SeriousIncident ;
         :hasAssociatedRisk :RSK-003 ;
         :involvesDevice :DEV-001 ;
         :reportedBy :MAN-001 ;
         :correctiveActionTaken "true"^^xsd:boolean ;
         :countryReported "Germany" ;
         :detectionDate "2024-01-10"^^xsd:date ;
         :eudamedIncidentRef "EU-INC-2024-000001" ;
         :eventDate "2024-01-08"^^xsd:date ;
         :incidentDescription "Patient implanted with HeartMate 3 LVAD developed ischemic stroke 6 months post-implant. Device thrombus confirmed by echocardiography." ;
         :incidentId "INC-001" ;
         :outcome "Serious patient injury - embolic stroke" ;
         :patientAge "58" ;
         :patientSex "Male" ;
         :reportDate "2024-01-15"^^xsd:date ;
         rdfs:label "INC-001"@en .


